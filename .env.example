# Leave blank for a Vercel-generated preview URL. Set only when a custom domain is approved.
NEXT_PUBLIC_SITE_URL=
# Enable only for the approved live deployment. Preview builds remain noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false
# HTTPS endpoint that accepts a JSON enquiry and returns a 2xx status after delivery is accepted.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
